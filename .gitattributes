# Auto detect text files and normalize line endings
* text=auto eol=lf

# .NET / C# / Avalonia
*.cs     text diff=csharp
*.axaml  text eol=lf
*.xaml   text eol=lf
*.csproj text eol=lf
*.props  text eol=lf
*.targets text eol=lf
*.sln    text eol=crlf

# Scripts
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.sh     text eol=lf

# Docs and configs
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf

# Binary files
*.ico    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.zip    binary
