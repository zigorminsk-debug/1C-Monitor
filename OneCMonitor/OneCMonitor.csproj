<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>1C-Server-Monitor</AssemblyName>
    <RootNamespace>OneCMonitor</RootNamespace>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Version>1.6.0</Version>
    <Authors>Zakharevich Igor</Authors>
    <Company>ООО «Компьютерная безопасность»</Company>
    <Product>1C Server Monitor</Product>
    <Description>Мониторинг нагрузки сервера 1С, процессов rphost и пользовательских сеансов</Description>
    <Copyright>© 2026 Zakharevich Igor · csl.by</Copyright>
    <RepositoryUrl>https://github.com/zigorminsk-debug/1C-Monitor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OneCMonitor.Core\OneCMonitor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.7" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
</Project>
