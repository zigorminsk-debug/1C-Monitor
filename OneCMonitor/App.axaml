<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OneCMonitor.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    <Style Selector="Window"><Setter Property="Background" Value="#0D1422"/><Setter Property="FontFamily" Value="Inter, Segoe UI"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="14,8"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#151F30"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/><Setter Property="BorderBrush" Value="#273449"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#8FA0B8"/></Style>
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="DataGrid"><Setter Property="Background" Value="#111A29"/><Setter Property="BorderBrush" Value="#273449"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#253248"/><Setter Property="RowBackground" Value="#111A29"/></Style>
    <Style Selector="ScrollBar:horizontal"><Setter Property="Height" Value="20"/><Setter Property="MinHeight" Value="20"/></Style>
    <Style Selector="ScrollBar:vertical"><Setter Property="Width" Value="18"/><Setter Property="MinWidth" Value="18"/></Style>
  </Application.Styles>
</Application>
